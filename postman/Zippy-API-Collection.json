        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"shipment_id\": \"FS-700001\",\n  \"tracking_number\": \"FST123456789\",\n  \"event_code\": \"IN_TRANSIT\",\n  \"event_description\": \"Shipment departed Bengaluru hub\",\n  \"event_time\": \"2026-07-25T10:30:00Z\",\n  \"location\": \"Bengaluru Hub\"\n}"
        },
        "url": "{{baseUrl}}/api/webhooks/fastship"
      }
    },
