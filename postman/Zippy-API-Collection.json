  "item": [
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantOrderId\": \"MERCHANT-10001\",\n  \"customer\": {\n    \"name\": \"Rahul Sharma\",\n    \"phone\": \"9876543210\",\n    \"email\": \"rahul@example.com\"\n  },\n  \"pickupAddress\": {\n    \"addressLine1\": \"15 MG Road\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"pincode\": \"560001\"\n  },\n  \"deliveryAddress\": {\n    \"addressLine1\": \"22 Connaught Place\",\n    \"city\": \"New Delhi\",\n    \"state\": \"Delhi\",\n    \"pincode\": \"110001\"\n  },\n  \"package\": {\n    \"weightGrams\": 1500,\n    \"lengthCm\": 20,\n    \"widthCm\": 15,\n    \"heightCm\": 10\n  },\n  \"paymentType\": \"COD\",\n  \"codAmount\": 2500\n}"
        },
        "url": "{{baseUrl}}/api/orders"
      }
    },
    {
      "name": "Get Order",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders/{{orderId}}"
      }
    },
    {
      "name": "Get Rates",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders/{{orderId}}/rates?sortBy=lowest"
      }
    },
    {
      "name": "Select Carrier",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"carrierCode\": \"FASTSHIP\",\n  \"serviceCode\": \"FAST-AIR\",\n  \"quotedAmount\": 182.9\n}"
        },
        "url": "{{baseUrl}}/api/orders/{{orderId}}/select-carrier"
      }
    },
    {
      "name": "Create Shipment",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/orders/{{orderId}}/create-shipment"
      }
    },
    {
      "name": "Get Tracking",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders/{{orderId}}/tracking"
      }
    },
    {
      "name": "FastShip Webhook",
      "request": {
