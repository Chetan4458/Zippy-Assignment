# Docker Compose reads this file after it is copied to .env.
# Never commit .env. Replace placeholder values before using this example.

# Optional stable prefix for Compose containers, networks, and volumes.
COMPOSE_PROJECT_NAME=zippy

# Compose is a loopback-only local demo. The image itself defaults to prod and
# fails closed until the security and datasource settings below are supplied.
SPRING_PROFILES_ACTIVE=local
SERVER_ADDRESS=0.0.0.0

# Local demo database credential. Use a long, randomly generated value.
ZIPPY_DB_PASSWORD=replace-with-a-long-random-password

# Set to false when manually replaying carrier webhook scenarios.
ZIPPY_AUTOMATION_ENABLED=true

# Required when SPRING_PROFILES_ACTIVE=prod. Generate independent random values
# of at least 32 characters and inject them through a managed secret store for a
# real deployment; these placeholders are intentionally unusable examples.
ZIPPY_API_KEY=replace-with-a-random-api-key-at-least-32-characters
ZIPPY_WEBHOOK_SECRET_FASTSHIP=replace-with-an-independent-fastship-secret
ZIPPY_WEBHOOK_SECRET_QUICKEXPRESS=replace-with-an-independent-quickexpress-secret
ZIPPY_WEBHOOK_SECRET_RELIABLE=replace-with-an-independent-reliable-secret
